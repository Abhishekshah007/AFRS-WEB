# Set to "true" to show the public maintenance page (admin + API stay available)
MAINTENANCE_MODE=false

# Optional: when set, CMS errors are tagged for external monitoring integration

# Required — also used to sign registration confirmation URLs (?token=)
PAYLOAD_SECRET=
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=

# Cloudinary media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUBMISSION_NOTIFY_EMAIL=

# Chatbot (set at least one)
GROQ_API_KEY=
GEMINI_API_KEY=

# Cloudflare Turnstile — required in production for registration/contact forms
# Test keys (always pass): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA