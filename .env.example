# Set to "true" to show the public maintenance page (admin + API stay available)
MAINTENANCE_MODE=false

# ─── Required ───────────────────────────────────────────────────────────────
# Also used to sign registration confirmation URLs (?token=)
PAYLOAD_SECRET=
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Cloudinary (required in production) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional — default: afrs/payload/media (do not change after go-live)
# CLOUDINARY_MEDIA_PREFIX=afrs/payload/media

# ─── Email / Resend (required in production) ────────────────────────────────
# Payload admin (forgot password) + form notification emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=AFRS <noreply@yourdomain.com>
SUBMISSION_NOTIFY_EMAIL=
# SITE_NOTIFY_EMAIL=

# ─── Cloudflare Turnstile (required in production) ────────────────────────
# Dev/test keys below always pass — replace for production deploy
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
FRONTEND_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Chatbot (optional — at least one for live chat) ──────────────────────
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.0-flash

# ─── Server-only fallback ───────────────────────────────────────────────────
# SITE_URL=
